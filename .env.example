# Copia este archivo como .env si necesitas apuntar a otro backend.
# Si no existe .env, se usa http://127.0.0.1:8000 por defecto.
#
# OJO: todo lo que empiece por VITE_ se compila DENTRO del bundle que se
# descarga el navegador. Es público. Aquí nunca va una clave de Supabase ni
# de Groq: el frontend habla con FastAPI, y FastAPI guarda los secretos.

VITE_API_URL=http://127.0.0.1:8000
